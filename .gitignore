# ide
.vscode

# macOS metadata
.DS_Store
**/.DS_Store

# install artefacts
tmp
temp
**/logs
**/*.deb
.playwright-mcp/

# ssh env
**/id_*
**/known_hosts*
**/config.d

# setup files
**/autoload
**/pypoetry

# Copilot CLI runtime/private state. These normally live in the real
# ~/.copilot directory, but keep them out of Git if Stow ever folds it.
home/.copilot/chats
home/.copilot/command-history-state.json
home/.copilot/config.json
home/.copilot/data.db*
home/.copilot/history-session-state
home/.copilot/ide
home/.copilot/installed-plugins
home/.copilot/mcp-config.json
home/.copilot/mcp-config.local.json
home/.copilot/mcp-oauth-config
home/.copilot/repos
home/.copilot/restart
home/.copilot/servers
home/.copilot/session-state
home/.copilot/session-store.db*
home/.copilot/settings.json.lock
home/.copilot/sidebar-sessions-state

# XDG runtime state (safety net: 23-stow.sh mkdir's ~/.local/bin so stow links
# only bin/ scripts and never folds ~/.local into the repo — but if a fold ever
# recurs, keep mise/gh/zsh runtime writes out of version control)
home/.local/share
home/.local/state

# vim plugins (installed via install script)
home/.vim/pack

# tmux plugins (installed via install script)
home/.tmux/plugins

# compiled binaries
home/.tmux/donut

*.zwc

# python bytecode (e.g. from linting bin/ python helpers)
__pycache__/
*.pyc
